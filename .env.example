# ---------------------------------------------------------------------------
# EV Battery Swap Station Digital Twin -- extraction engine configuration
#
#   cp .env.example .env      then fill in the four required values
#   NEVER commit .env (it holds the API passcode, which is shown only once)
# ---------------------------------------------------------------------------

# =============================== REQUIRED ===================================

# Upstream base URL, no trailing slash.
# Defaults to the verified Blue Energy Motors host, so this only needs setting
# for a staging upstream or the local mock server (http://127.0.0.1:8899).
API_BASE_URL=https://track.blueenergymotors.com

# Issued once by POST /api/admin/api-clients (guide section 1).
API_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxx
API_PASSCODE=xxxxxxxxxxxx

# PostgreSQL. Note the driver: psycopg (v3), not psycopg2.
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/twin


# =========================== POLLING & AUTH =================================

# How often to call /api/v1/vehicles.
POLL_INTERVAL_SECONDS=60

# Proactive token rotation. The server's token lives 3540 s (59 min) and there
# is no refresh endpoint, so we re-authenticate at 3300 s = 55 min and keep a
# 240 s safety margin. The engine uses whichever deadline comes first, so if the
# server ever shortens expires_in we follow it automatically.
TOKEN_REFRESH_INTERVAL=3300
TOKEN_EXPIRY_SAFETY_MARGIN=240

# Pauses after a failed cycle. Keep AUTH_BACKOFF_SECONDS generous: hammering the
# auth endpoint with a bad passcode is how an API client gets disabled.
ERROR_BACKOFF_SECONDS=30
AUTH_BACKOFF_SECONDS=300


# ============================== RETRY ======================================

# Retries apply to 5xx / timeouts / connection resets only. 400/401/403/404 are
# never retried. Backoff is exponential with full jitter, capped at the max.
HTTP_MAX_RETRIES=5
BACKOFF_BASE_SECONDS=1.0
BACKOFF_MAX_SECONDS=60.0
REQUEST_TIMEOUT=20


# ============================ OPTIONAL FILTERS ==============================

# Leave empty to let the server default to today (IST).
API_DATE=
# Substring filter on vehicle id, on top of the client's own scoping.
API_VEHICLE_FILTER=


# ========================= LIVE DATE RESOLUTION =============================

# The upstream keys every fleet batch on `date` (default: today, IST).  When
# the configured date -- or the server default -- answers with an empty or
# dead batch (roster entries carrying no readings), the engine probes for the
# freshest date that actually holds a live fleet: dates read off the fleet's
# own `last_updated` values first, then a walk back over recent days.  The
# winning date is cached, so steady-state polls still send one tier-1 GET.

# true (default): probe for a live batch instead of ingesting nothing.
LIVE_DATE_FALLBACK=true
# Active-vehicle count a batch must reach to be accepted without probing.
LIVE_DATE_MIN_VEHICLES=5
# How many days back the walk-back tier reaches (newest first).
LIVE_DATE_PROBE_DAYS=14
# Hard cap on tier-1 GETs spent per resolution.
LIVE_DATE_MAX_PROBES=8
# Cooldown before re-probing when the last resolution ended best-effort.
LIVE_DATE_REPROBE_SECONDS=900


# ============================== DATABASE ====================================

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_SCHEMA=public


# ============================== BEHAVIOUR ===================================

# false (default): a vehicle frame missing parameters is stored with NULLs and
#   logged -- required if your API client is field-restricted in the
#   Administration tab, or if some trucks simply report fewer signals.
# true: reject any frame that is not carrying all 24 parameters.
REQUIRE_ALL_FIELDS=false

# false (default): skip a history row when a vehicle reports exactly what it
#   reported last poll (huge write saving for parked trucks).
WRITE_UNCHANGED=false

# What to key a history row on when the frame has no usable `last_updated`:
#   ingest -> use our own ingest time (default, keeps history complete)
#   drop   -> skip the vehicle and log it (never invent a timestamp)
FALLBACK_OBSERVED_AT=ingest

# Timezone of the naive `last_updated` strings. Stored as UTC in the database.
SOURCE_TIMEZONE=Asia/Kolkata


# ============================== LOGGING =====================================

LOG_LEVEL=INFO
# true -> one JSON object per line, for Loki / CloudWatch / Datadog
LOG_JSON=false


# ============================== METRICS =====================================

# Prometheus text endpoint on :METRICS_PORT/metrics
METRICS_ENABLED=false
METRICS_PORT=9464
