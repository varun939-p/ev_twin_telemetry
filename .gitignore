# Credentials -- the API passcode is shown exactly once and is not recoverable.
.env
.env.*
!.env.example
*.pem
secrets.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Runtime artifacts
# `uploads/` holds manual capture files; `trusted_vehicle_telemetry.json` is
# the (optional, offline-only) output of `python main_parser.py`.  Neither is
# source -- production reads Neon, not files.
uploads/
/trusted_vehicle_telemetry.json
*.tmp

# NOTE: `blue_energy_response.json` is deliberately NOT ignored.  It is the
# verified upstream capture that `python main_parser.py` consumes for offline
# validation work.  (An earlier revision of this file tried to ignore it, but
# the lines had been appended as UTF-16 and silently matched nothing -- see
# git history.)

