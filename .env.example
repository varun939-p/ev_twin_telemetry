# ---------------------------------------------------------------------------
# EV Battery Swap Station Digital Twin -- configuration
#
# One deployment, two runtimes, one env file:
#   * the Next.js dashboard (npm run dev)   -- DASHBOARD section
#   * the Python control plane + engine     -- CONTROL PLANE / ENGINE sections
#     HTTP: python -m uvicorn telemetry.main:app --host 0.0.0.0 --port 8000
#     WORKER (separate terminal): python -m telemetry run
#     Vercel: api/index.py wraps the SAME telemetry.main.app; cron owns polling.
#     Starting uvicorn alone does NOT poll. main_parser.py is offline-only.
#
#   cp .env.example .env      then fill in the values marked REQUIRED
#   NEVER commit .env -- it holds the API passcode (shown only once) and the
#   database credentials.
#
# On Vercel, set these in Settings -> Environment Variables instead; the full
# checklist is in DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# ==================== CONTROL PLANE + ENGINE (REQUIRED) =====================

# Neon PostgreSQL. Note the driver: psycopg (v3), not psycopg2. Use the
# POOLED connection string (…-pooler…neon.tech/…) for serverless.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx-pooler.region.aws.neon.tech/twin?sslmode=require

# Blue Energy Motors credentials, issued once by POST /api/admin/api-clients
# (guide section 1). The passcode is not recoverable once lost.
API_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxx
API_PASSCODE=xxxxxxxxxxxx

# Upstream base URL, no trailing slash. Defaults to the verified Blue Energy
# Motors host; set it explicitly only for staging or the local mock server.
API_BASE_URL=https://track.blueenergymotors.com

# Bearer secret for the ingestion routes. Vercel Cron sends
#   Authorization: Bearer $CRON_SECRET
# automatically when this env var is set on the project. External schedulers
# must send it explicitly. REQUIRED ON VERCEL (the ingest routes fail closed
# without it); leave blank for local development.
CRON_SECRET=

# ============================== DASHBOARD ===================================

# The control plane's origin, when it is NOT this deployment. Leave UNSET on
# Vercel: the default is the request's own origin, and the /api/* rewrite in
# next.config.mjs carries it to the Python function in the same project.
# TELEMETRY_API_URL=

# Local rewrite target for /api/* (next.config.mjs) -- the uvicorn control
# plane running alongside `npm run dev`.
BACKEND_URL=http://127.0.0.1:8000

# Endpoint paths. Override only for a staging layout.
TELEMETRY_DOC_PATH=/api/telemetry/trusted
TELEMETRY_HEALTH_PATH=/api/health

# Seconds a fetched document may be reused across renders. Keep this at or
# below the polling interval. Reads do not start ingestion; normal propagation
# also includes cycle duration and the visible-tab refresh interval (20s).
TELEMETRY_REVALIDATE_SECONDS=30

# Abort budget for the document fetch and the health probe. On timeout the
# dashboard renders the empty/"waiting" state and says so in the header chip.
TELEMETRY_TIMEOUT_MS=6000

# ============================ POLLING & AUTH ================================

# Polling interval for the long-lived loop (`python -m telemetry run`) and Docker
# deployment; also the EXPECTED cadence in diagnostics. The shipped vercel.json
# uses a Hobby-compatible daily cron (0 18 * * *). If you deploy to Hobby, set
# POLL_INTERVAL_SECONDS to 86400 in the Vercel environment so the dashboard does
# not permanently label a healthy daily cron as "Ingestion overdue"; keep 300
# for the continuous local worker or a real-time external scheduler.
POLL_INTERVAL_SECONDS=300

# A journal row left running longer than this is reported as stalled. This
# is a diagnostic threshold, NOT cancellation. Vercel maxDuration is 60s.
INGEST_RUNNING_TIMEOUT_SECONDS=60

# Per-warm-instance manual-trigger cooldown, not a distributed scheduler lock.
INGEST_MIN_INTERVAL_SECONDS=45

# Proactive token rotation. The server's token lives 3540 s (59 min) and there
# is no refresh endpoint, so we re-authenticate at 3300 s = 55 min and keep a
# 240 s safety margin.
TOKEN_REFRESH_INTERVAL=3300
TOKEN_EXPIRY_SAFETY_MARGIN=240

# Pauses after a failed cycle. Keep AUTH_BACKOFF_SECONDS generous: hammering
# the auth endpoint with a bad passcode is how an API client gets disabled.
ERROR_BACKOFF_SECONDS=30
AUTH_BACKOFF_SECONDS=300

# ============================== RETRY =======================================

# Retries apply to 5xx / timeouts / connection resets only. 400/401/403/404
# are never retried. Backoff is exponential with full jitter, capped at max.
HTTP_MAX_RETRIES=5
BACKOFF_BASE_SECONDS=1.0
BACKOFF_MAX_SECONDS=60.0
REQUEST_TIMEOUT=20

# ========================= LIVE DATE RESOLUTION =============================

# The upstream keys every fleet batch on `date` (default: today, IST).  When
# the configured date -- or the server default -- answers with an empty or
# dead batch, the engine probes for the freshest date that actually holds a
# live fleet. Current default, recent calendar days and reporting hints are
# checked newest-first (a final slot may retain a known older fleet). This uses
# one tier-1 GET for a healthy current feed. Historical winners are checked
# against newer dates every cycle, not cached forever. Failed probes count
# in the candidate budget (HTTP retries are separate); newer data outside
# the examined dates cannot be ruled out.
LIVE_DATE_FALLBACK=true
LIVE_DATE_MIN_VEHICLES=5
LIVE_DATE_PROBE_DAYS=14
LIVE_DATE_MAX_PROBES=8
# Throttle full BEST-EFFORT searches only. The current default is still checked
# every cycle so new live data there can be discovered immediately.
LIVE_DATE_REPROBE_SECONDS=900

# Leave unset for live monitoring. A healthy explicit date is an intentional
# archive filter; the dashboard will label it date-limited.
# API_DATE=
# API_VEHICLE_FILTER=

# ============================== DATABASE ====================================

# Pool sizing applies to the long-lived process. On Vercel the engine forces
# NullPool automatically (a pooled socket would die between invocations);
# DB_NULLPOOL=true forces it everywhere else.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_SCHEMA=public
DB_NULLPOOL=false

# ============================== BEHAVIOUR ===================================

# false (default): a vehicle frame missing parameters is stored with NULLs and
#   logged -- required if your API client is field-restricted, or if some
#   trucks simply report fewer signals.
# true: reject any frame that is not carrying all 24 parameters.
REQUIRE_ALL_FIELDS=false

# false (default): skip a history row when a vehicle reports exactly what it
#   reported last cycle (huge write saving for parked trucks).
WRITE_UNCHANGED=false

# What to key a history row on when the frame has no usable `last_updated`:
#   ingest -> use our own ingest time (default, keeps history complete)
#   drop   -> skip the vehicle and log it (never invent a timestamp)
FALLBACK_OBSERVED_AT=ingest

# Timezone of the naive `last_updated` strings. Stored as UTC in the database.
SOURCE_TIMEZONE=Asia/Kolkata

# ============================== LOGGING =====================================

LOG_LEVEL=INFO
# true -> one JSON object per line, for Vercel Logs / Datadog
LOG_JSON=false

# ============================== METRICS =====================================

# Prometheus text endpoint -- long-lived/Docker deployments only (a Vercel
# function cannot bind a port).
METRICS_ENABLED=false
METRICS_PORT=9464
