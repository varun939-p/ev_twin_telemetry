# ---------------------------------------------------------------------------
# Telemetry pipeline — server-side only.
#
# Copy to `.env.local` (gitignored) for development, or set these in the
# platform's secret store for a deployment. NONE of these are `NEXT_PUBLIC_*`,
# so none of them can reach the browser bundle: `lib/telemetry-source.ts` is
# marked `server-only`, which makes an accidental client import a BUILD error
# rather than a leaked fleet credential.
# ---------------------------------------------------------------------------

# Control plane that serves the validated document (telemetry/main.py).
# Default: http://127.0.0.1:8000
TELEMETRY_API_URL=http://127.0.0.1:8000

# Endpoint paths. Override only for a staging layout.
TELEMETRY_DOC_PATH=/api/telemetry/trusted
TELEMETRY_AUTH_PATH=/api/auth/api-token

# Cheap liveness probe, fetched with `cache: "no-store"` on every render.
# It exists because the document fetch CANNOT prove the control plane is up:
# Next's data cache is stale-while-revalidate, so a failed revalidation
# silently replays the last good response. Without this probe the header chip
# reported "Live" through a 65-second outage.
TELEMETRY_HEALTH_PATH=/health

# Machine credentials issued by POST /api/admin/api-clients.
# Exchanged for a 59-minute bearer token, cached in-process and retired 120s
# early. Leave BLANK when the control plane is unauthenticated (the local
# FastAPI dev server is) — the loader simply skips the exchange.
TELEMETRY_API_SECRET_KEY=
TELEMETRY_API_PASSCODE=

# Seconds a fetched document may be reused across renders. Keep this at or
# below the parser's poll interval so the dashboard is never more than one
# poll behind. Every concurrent viewer shares one upstream request.
TELEMETRY_REVALIDATE_SECONDS=30

# Abort budget for both the token exchange and the document fetch. On timeout
# the dashboard renders the committed snapshot and says so in the header chip.
TELEMETRY_TIMEOUT_MS=6000

# Set to `snapshot` to pin the UI to `data/trusted_vehicle_telemetry.json` and
# skip the network entirely — useful for offline demos and deterministic tests.
# TELEMETRY_SOURCE=snapshot

# Proxy target for the /api/* rewrites in next.config.mjs.
BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# VERCEL
#
# Set TELEMETRY_API_URL to the PUBLIC origin of the control plane — a Vercel
# function cannot reach 127.0.0.1, so leaving the default means every render
# falls back to the committed snapshot and the header chip reads "Snapshot".
# That is a safe failure, not a crash, but it is not live data.
#
# Set the four TELEMETRY_* values as Encrypted Environment Variables. None of
# them are NEXT_PUBLIC_*, so they stay server-side; `lib/telemetry-source.ts`
# is marked `server-only`, which makes an accidental client import a build
# error rather than a leaked fleet credential.
#
# All three routes are `force-dynamic`, so they run as serverless renders and
# never sit in a shared CDN cache. Fonts are vendored as .woff2 in app/fonts,
# so the build needs no network access to fonts.googleapis.com.
# ---------------------------------------------------------------------------
